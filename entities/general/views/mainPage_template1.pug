//- Розбивка тіла головної сторінки на дві частини.
//- До 800px частини стоять одна під одною, сторінка прокручується.
//- Ширше — ліворуч 25% (поточні значення і процес), праворуч 75% (графік).

.page-split
  .page-split__side
    .page-split__values !{currentValuesContainer}
    #entity_processContainer !{processContainer}
  #entity_graphContainer.page-split__main !{graphContainer}

script.
  setTimeout(()=>{chartMan.chart.start()},5000);
