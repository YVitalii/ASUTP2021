@startuml trp08_simulator_regs.tT
title TRP08 Simulator_regs.tT
start
:value;
    split 
        :set(val);
        :this.regs.tT._value = val;
        :this.regulator.setParams({setPoint: val});
        if (this.state == "heating") then (yes)
            :this.heatingStep.init();
        endif
    split again
        :get();
    split again
        :this.regs.tT.modbus=modbusIntegerBCD(this.regs.tT);
    end split
    :return this.regs.tT._value;
end
@enduml


@startuml trp08_simulator_modbusIntegerBCD(reg)
title modbusIntegerBCD(reg)
start
    :return worker;
    note right
    worker = {
        set: (val:Buffer) => {
            reg._value = fromBCD(val);
        },
        get: () => {
            return toBCD(reg._value):Buffer;
        }
    }
    end note
end
@enduml
