@startuml trp08_simulator_setParamsStep
title TRP08 Simulator_setParams(params)

start
    :this.regulator.setParams();
note right
let regs = {
  kp : this.regs.o
  ki : this.regs.ti
  kd : this.regs.td
  setPoint : this.regs.tT
}
end note    
    :return;
end

@enduml

@startuml trp08_simulator_regs.T
title TRP08 Simulator_regs.T
start
split 
    :set(val);
    :throw new Error("readOnly");
    stop
split again
    :get();
    note left
     await this.regulator.calculate();
     t=this.regulator.processValue;
     this.regs.T._value = t;
    end note
end split
:return this.regs.T._value;
end
@enduml


@startuml trp08_simulator_regs.o
title TRP08 Simulator_regs.o
start
split 
    :set(val);
    :this.regulator.setParams({kp: val});
    :this.regs.o._value = val;
split again
    :get();
end split
:return this.regs.o._value;
end
