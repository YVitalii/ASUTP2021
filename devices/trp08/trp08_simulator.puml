
@startuml trp08_simulator_constructor
title TRP08 Simulator_constructor
start
   :this.regs;
   note right
    this.regs = {
        o: 2,
        ti: 0,
        td: 0,
        tT: 100,
        regMode:1,
        H: "0010",
        Y:"0010",

    };
   end note
   if (props.getPV not function) then (yes)
    :throw new Error("getPV is not function");
    stop
   endif
   :this.getPV = props.getPV;
   if (props.setOutput not function) then (yes)
    :throw new Error("setOutput is not function");
    stop
   endif
   :this.setOutput = props.setOutput; 
   


   :this.pid;
   note right
    props.pid = props.pid ? props.pid : {};
    props.pid.autoCalculation=false;
    props.pid.getPV=async () => {
        return this.getPV();
    };
    props.pid.setOutput=async (val) => {
        await this.setOutput(val);
    };
    this.pid=new PID(props.pid);
   end note
end
@enduml


@startuml trp08_simulator_regs_state
title TRP08 Simulator_regs_state

start
group "this.regs.state" {
    split 
    :set(val);
    if (val == 17) then (yes)
        if (this.state == "waiting" || this.state = "finished") then (yes)
            :this.start();
            :this.regs.state._value = 23;
        endif
    else (no)
        if (val == 1) then (yes)
            if (this.state != "waiting" || this.state != "finished") then (yes)
                :this.stop();
                :this.regs.state._value = 1;
            endif
        else (No)
         : throw new Error("Invalid value");
         end
        endif
    endif
    split again
    :get();
    
    end split
    :return this.regs.state._value;
}
end

@enduml

@startuml trp08_simulator_start
title TRP08 Simulator_start()

start
    :this.state = "setParams";
    :await this.setParamsStep(this.regs);
    :this.startTime = new Date();
    :this.heatingStep.init(this.regs);
    :this.regulator.start();
end

@enduml

@startuml trp08_simulator_stop
title TRP08 Simulator_stop()
start  
    :this.regulator.stop();
    :this.state = "waiting";
end

@enduml

@startuml TRP08 Simulator_heatingStep.init
title TRP08 Simulator_heatingStep.init(regs)
start
:this.heatingStep.init();
note right
    this.heatingStep.startTime=new Date();
    this.heatingStep.duration = toMinutes(this.regs.H);
    this.heatingStep.endTime=new Date(this.heatingStep.startTime.getTime(
    ) + this.heatingStep.duration * 60 * 1000 ));
    this.start_tT= this.regs.T;
    this.end_tT= this.regs.tT;
    this.heatingStep.f =  new LinearFunction(
        this.heatingStep.startTime.getTime(), 
        this.heatingStep.start_tT,
        this.heatingStep.endTime, 
        this.heatingStep.end_tT);
    this.state = "heating";
    this.currentStep = this.heatingStep;
end note
end

@enduml

