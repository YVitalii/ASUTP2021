@startuml initSync

title initSync() method
start
if (!fs.existsSync(this.path.programDir)) then (Yes)
    :fs.mkdirSync(this.path.programDir, { recursive: true });
else (No)
    :this.tasksList = fs.readdirSync(this.path.programDir);
endif

if (!fs.existsSync(this.path.stateFile)) then (Yes)
    if (!fs.existsSync(pathJoin(this.path.programDir, "default"))) then (Yes)
        :APIerror msg:
        {ua: "Файл шаблону програми (default) не знайдено",
         en: "Default program template file not found",
         ru: "Файл шаблона программы (default) не найден"};
        stop
    endif
    :fs.writeFileSync(this.path.stateFile,
    { activeProgram: "default", lastChange: Date.now() });
else (No)
endif
:state = JSON.parse(fs.readFileSync(this.path.stateFile, "utf8"));
:this.activeTask.fileName = state.activeProgram;
:this.activeTask.content = parseProgramContent(
  this.fileManager.readFileSync(activeProgram));
end
@enduml

@startuml loadTask

title async loadTask(taskName=undefined)
start
if (!taskName) then (Yes)
    :return this.activeTask.content;
    stop
endif
:data = await this.fileManager.readFile(taskName);
:return JSON.parse(data);
end
@enduml

@startuml readTasksList

title async readTasksList()
start
:this.tasksList = await fs.promises.readdir(this.path.programDir);
:return this.tasksList;
end
@enduml

@startuml getTasksList

title getTasksList()
start
:return this.tasksList;
end
@enduml

@startuml saveTask

title async saveTask(taskName=undefined, content=undefined)
start
if (!taskName || content === undefined) then (Yes)
    :APIerror msg:
    {ua: "Потрібно вказати taskName та content",
     en: "taskName and content are required",
     ru: "Необходимо указать taskName и content"};
    stop
endif
if (taskName === "default") then (Yes)
    :APIerror msg:
    {ua: "Не можна змінювати шаблон програми",
     en: "Cannot modify the program template",
     ru: "Нельзя изменять шаблон программы"};
    stop
endif
:await this.fileManager.writeFile(taskName, content);
note right
  файл: programDir + taskName
  створює / перезаписує
end note
if (!this.tasksList.includes(taskName)) then (Yes)
    :this.tasksList.push(taskName);
endif
end
@enduml

@startuml deleteTask

title async deleteTask(taskName)
start
if (!taskName) then (Yes)
    :APIerror msg:
    {ua: "Потрібно вказати taskName",
     en: "taskName is required",
     ru: "Необходимо указать taskName"};
    stop
endif
if (taskName === "default") then (Yes)
    :APIerror msg:
    {ua: "Не можна видаляти шаблон програми",
     en: "Cannot delete the program template",
     ru: "Нельзя удалять шаблон программы"};
    stop
endif
if (taskName === this.activeTask.fileName) then (Yes)
    :APIerror msg:
    {ua: "Не можна видаляти активну програму",
     en: "Cannot delete the active program",
     ru: "Нельзя удалять активную программу"};
    stop
endif
if (!this.fileManager.exist(taskName)) then (Yes)
    :APIerror msg:
    {ua/en/ru: "Файл програми не знайдено: " + taskName};
    stop
endif
:await this.fileManager.deleteFile(taskName);
:this.tasksList = this.tasksList.filter(name => name !== taskName);
end
@enduml

@startuml getActiveTask

title getActiveTask()
start
:return {
  taskName: this.activeTask.fileName,
  content: clone(this.activeTask.content)
};
end
@enduml

@startuml getFullHtml

title getFullHtml()
start
:return pug.renderFile(views/editTasks.pug);
note right
  дані редактор бере по API,
  manager не передається
end note
end
@enduml

@startuml setActiveTask

title async setActiveTask(taskName=undefined)
start
if (!taskName || !this.fileManager.exist(taskName)) then (Yes)
    :APIerror msg:
    {ua/en/ru: "Файл програми не знайдено: " + taskName};
    stop
endif
:try;
:content = await this.loadTask(taskName);
:this.activeTask.fileName = taskName;
:this.activeTask.content = content;
:writeFile state.info
{ activeProgram: taskName, lastChange: Date.now() };
:except;
:rethrow APIerror / wrap as APIerror;
end
@enduml
